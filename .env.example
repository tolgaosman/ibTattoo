# Copy this file to `.env` on the deployment host (next to docker-compose.yml)
# and fill in real, unique secrets. `.env` itself must never be committed —
# see .gitignore. `docker compose` reads this automatically.

# php artisan key:generate --show  (run once, inside the backend container or
# a local PHP install with the same Laravel version)
APP_KEY=

# MySQL application user password (ibtattoo_user) — pick a long random value.
DB_PASSWORD=

# MySQL root password — pick a different long random value.
MYSQL_ROOT_PASSWORD=

# Single admin account used to sign in to the Next.js admin panel. The
# backend seeds/updates this user on every container start (see
# backend/database/seeders/AdminUserSeeder.php), so rotating ADMIN_PASSWORD
# here and restarting the backend is enough to change the login password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
