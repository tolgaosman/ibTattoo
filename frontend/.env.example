# Base URL of the Laravel API (server-side only, never exposed to the browser).
API_URL=http://127.0.0.1:8000/api

# The single admin account's email (app/auth/login/route.ts). Must match
# ADMIN_EMAIL in the backend's own .env — that's what actually seeds/updates
# the account (backend/database/seeders/AdminUserSeeder.php). Only the
# password is entered on the login page; this pairs it with an account.
ADMIN_EMAIL=admin@example.com
