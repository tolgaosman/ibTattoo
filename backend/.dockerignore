# `composer install` runs inside the image; a host vendor/ would shadow it.
vendor
node_modules

# The entrypoint creates .env from .env.example on first boot. Shipping a local
# .env instead would pin DB_HOST=127.0.0.1 and a local admin password.
.env
.env.local
.env.*.local

storage/logs
storage/framework/cache/data
storage/framework/sessions
storage/framework/views
database/*.sqlite

# Package-discovery cache, regenerated by `composer install`'s post-autoload-dump
# hook. A stale copy baked from a host checkout that once had dev-only packages
# installed (e.g. laravel/pail) references classes the image's --no-dev vendor/
# doesn't have — every artisan command then fatals with "Class ... not found",
# which is exactly what crash-looped the backend container in production.
bootstrap/cache/*.php

.git
.gitignore
Dockerfile
.dockerignore
